# ─────────────────────────────────────────────────────────────
# Hill Country Consultants — environment
# Copy to .env.local for development; set the same keys in Vercel.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for metadata, emails, Stripe redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Service-role key — SERVER ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Stripe — Developers → API keys / Webhooks
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Resend — transactional email (booking confirmation, weekly report, shift alert)
RESEND_API_KEY=re_xxx
EMAIL_FROM="Hill Country Consultants <info@hillcountryconsultants.com>"
EMAIL_REPLY_TO=info@hillcountryconsultants.com
